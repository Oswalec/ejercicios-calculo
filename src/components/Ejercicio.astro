---
import { render, type CollectionEntry } from "astro:content";
import InsigniaDificultad from "./InsigniaDificultad.astro";
import { buscarSeccion, buscarTema } from "../data/temas.ts";
import { url } from "../lib/url.ts";

interface Props {
  ejercicio: CollectionEntry<"ejercicios">;
  nivelTitulo: 1 | 2;
  enlazar: boolean;
}

const { ejercicio, nivelTitulo, enlazar } = Astro.props;
const { Content } = await render(ejercicio);
const Titulo = nivelTitulo === 1 ? "h1" : "h2";
const tema = buscarTema(ejercicio.data.tema);
const seccion = buscarSeccion(ejercicio.data.tema, ejercicio.data.seccion);
if (!tema || !seccion) {
  throw new Error(
    `El ejercicio ${ejercicio.id} apunta a una sección que no existe: ${ejercicio.data.tema}/${ejercicio.data.seccion}.`,
  );
}
---

<article class="tarjeta-ejercicio">
  <Titulo class="titulo-ejercicio">{ejercicio.data.titulo}</Titulo>
  <dl class="ficha">
    <div>
      <dt>Tema</dt>
      <dd>
        {`${tema.numero}. ${tema.nombre} › ${seccion.numero} ${seccion.nombre}`}
      </dd>
    </div>
    <div>
      <dt>Dificultad</dt>
      <dd>
        <InsigniaDificultad dificultad={ejercicio.data.dificultad} />
      </dd>
    </div>
    <div>
      <dt>Método</dt>
      <dd>{ejercicio.data.metodo}</dd>
    </div>
  </dl>
  <div class="cuerpo-ejercicio">
    <Content />
  </div>
  {enlazar && (
    <a class="enlace-ejercicio" href={url(`ejercicio/${ejercicio.id}/`)}>
      Abrir este ejercicio en su propia página
    </a>
  )}
</article>

<style>
  .tarjeta-ejercicio {
    border: 1px solid var(--border);
    border-radius: var(--radio-md);
    padding: var(--espacio-4) var(--espacio-4) var(--espacio-6);
    margin-block: var(--espacio-6);
    box-shadow: var(--sombra-1);
  }
  .titulo-ejercicio {
    margin-block: 0 var(--espacio-2);
  }
  .ficha {
    display: grid;
    gap: var(--espacio-1);
    margin: 0 0 var(--espacio-4);
    font-size: 0.9375rem;
  }
  .ficha div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espacio-2);
  }
  .ficha dt {
    font-weight: 700;
    color: var(--fg-muted);
  }
  .ficha dt::after {
    content: ":";
  }
  .ficha dd {
    margin: 0;
  }
  .cuerpo-ejercicio :global(details.solucion) {
    background: var(--surface);
    border-radius: var(--radio-md);
    padding: var(--espacio-2) var(--espacio-4);
    margin-top: var(--espacio-4);
  }
  .cuerpo-ejercicio :global(details.solucion > summary) {
    cursor: pointer;
    color: var(--primary);
    font-weight: 700;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .enlace-ejercicio {
    display: inline-block;
    margin-top: var(--espacio-4);
    font-size: 0.9375rem;
  }
</style>
