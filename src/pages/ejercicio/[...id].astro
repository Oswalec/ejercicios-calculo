---
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Ejercicio from "../../components/Ejercicio.astro";
import { buscarSeccion, buscarTema } from "../../data/temas.ts";
import { url } from "../../lib/url.ts";

export async function getStaticPaths() {
  const entradas = await getCollection("ejercicios");
  for (const entrada of entradas) {
    const [carpetaTema, carpetaSeccion] = entrada.id.split("/");
    const { tema, seccion } = entrada.data;
    if (carpetaTema !== tema || carpetaSeccion !== seccion) {
      throw new Error(
        `El ejercicio ${entrada.id} declara "${tema}/${seccion}" pero está en la carpeta "${carpetaTema}/${carpetaSeccion}".`,
      );
    }
    if (!buscarSeccion(tema, seccion)) {
      throw new Error(
        `El ejercicio ${entrada.id} usa la sección "${seccion}", que no existe en el tema "${tema}" (src/data/temas.ts).`,
      );
    }
  }
  return entradas.map((entrada) => ({
    params: { id: entrada.id },
    props: { ejercicio: entrada },
  }));
}

interface Props {
  ejercicio: CollectionEntry<"ejercicios">;
}

const { ejercicio } = Astro.props;
const tema = buscarTema(ejercicio.data.tema);
const seccion = buscarSeccion(ejercicio.data.tema, ejercicio.data.seccion);
if (!tema || !seccion) throw new Error(`Sección desconocida: ${ejercicio.id}`);
---

<Base
  titulo={`${ejercicio.data.titulo} | ${seccion.numero} ${seccion.nombre}`}
  descripcion={`Ejercicio resuelto paso a paso de ${seccion.nombre} (${tema.nombre}): ${ejercicio.data.titulo}.`}
>
  <a href={url(`tema/${tema.slug}/${seccion.slug}/`)}>
    ← {seccion.numero} {seccion.nombre}
  </a>
  <div data-pagefind-body>
    <Ejercicio ejercicio={ejercicio} nivelTitulo={1} enlazar={false} />
  </div>
</Base>
