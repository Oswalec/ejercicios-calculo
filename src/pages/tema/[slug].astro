---
import Base from "../../layouts/Base.astro";
import Ejercicio from "../../components/Ejercicio.astro";
import { temas, type Tema } from "../../data/temas.ts";
import { ejerciciosDeTema } from "../../lib/ejercicios.ts";
import { url } from "../../lib/url.ts";

export function getStaticPaths() {
  return temas.map((tema) => ({
    params: { slug: tema.slug },
    props: { tema },
  }));
}

interface Props {
  tema: Tema;
}

const { tema } = Astro.props;
const lista = await ejerciciosDeTema(tema.slug);
const total = lista.length;
const visibles = Math.min(total, 10);
---

<Base
  titulo={`Ejercicios resueltos de ${tema.nombre} | Ejercicios de Cálculo`}
  descripcion={tema.descripcion}
>
  <h1>{tema.nombre}</h1>
  <p class="lead">{tema.descripcion}</p>
  {total === 0 ? (
    <p class="vacio">Pronto habrá ejercicios de este tema.</p>
  ) : (
    <>
      <p id="estado-seleccion" aria-live="polite">
        Mostrando {visibles} de {total} ejercicios.
      </p>
      <button type="button" id="otros-ejercicios" class="boton" hidden>
        Dame otros ejercicios
      </button>
      <ol id="lista-ejercicios" class="lista-ejercicios" data-total={total}>
        {lista.map((e, i) => (
          <li class="ejercicio" data-indice={i} hidden={i >= 10}>
            <Ejercicio ejercicio={e} nivelTitulo={2} enlazar={true} />
          </li>
        ))}
      </ol>
    </>
  )}
  <a href={url("")}>← Todos los temas</a>
</Base>

<script>
  import {
    elegirAleatorios,
    otroConjunto,
    MINIMO,
  } from "../../lib/aleatorio.ts";

  const lista = document.getElementById("lista-ejercicios");
  const boton = document.getElementById("otros-ejercicios");
  const estado = document.getElementById("estado-seleccion");

  if (lista && boton && estado) {
    const items = Array.from(
      lista.querySelectorAll<HTMLLIElement>("li[data-indice]"),
    );
    const total = items.length;
    const mostrar = (indices: number[]) => {
      const elegidos = new Set(indices);
      items.forEach((item, i) => {
        item.hidden = !elegidos.has(i);
      });
      estado.textContent = `Mostrando ${indices.length} de ${total} ejercicios.`;
    };
    let actual = elegirAleatorios(total, Math.random);
    mostrar(actual);
    if (total > MINIMO) {
      boton.hidden = false;
      boton.addEventListener("click", () => {
        actual = otroConjunto(total, Math.random, actual);
        mostrar(actual);
        lista.scrollIntoView({ block: "start" });
      });
    }
  }
</script>

<style>
  .boton {
    background: var(--primary);
    color: var(--primary-fg);
    border: 0;
    border-radius: var(--radio-sm);
    min-height: 44px;
    padding: var(--espacio-3) var(--espacio-6);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 120ms ease-out;
  }
  .boton:hover {
    background: var(--primary-dark);
  }
  .lista-ejercicios {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .vacio {
    color: var(--fg-muted);
  }
</style>
